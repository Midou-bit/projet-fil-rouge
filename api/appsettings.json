{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=frameforge.db"
  },
  "Jwt": {
    "_comment": "Clé secrète NON committée → la mettre dans appsettings.Development.json ou via 'dotnet user-secrets'. À défaut, Program.cs applique une clé de dev de repli.",
    "Issuer": "FrameForge",
    "Audience": "FrameForgeClient",
    "ExpireHours": "12"
  },
  "Stripe": {
    "_comment": "Mode explicite : Simulation pour la démo locale, ou StripeTest avec une clé sk_test valide. Ne jamais utiliser de clé live.",
    "Mode": "Simulation",
    "SecretKey": "",
    "PublishableKey": "",
    "SuccessUrl": "http://localhost:5173/checkout/success",
    "CancelUrl": "http://localhost:5173/checkout/cancel"
  },
  "Games": {
    "ImportCount": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "login": { "PermitLimit": 10, "WindowSeconds": 60 },
      "register": { "PermitLimit": 5, "WindowSeconds": 600 },
      "support": { "PermitLimit": 5, "WindowSeconds": 600 },
      "compute": { "PermitLimit": 30, "WindowSeconds": 60 }
    }
  }
}
